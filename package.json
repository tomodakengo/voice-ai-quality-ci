{
  "name": "voice-ai-quality-ci",
  "version": "0.1.0",
  "private": true,
  "description": "音声AIアプリ(AmiVoice×LLM)の品質をCIで守る検証用PoC。評価ハーネス + Playwright fake-audio E2E。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "tsx app/server.ts",
    "mock-asr": "tsx src/amivoice/mock-server.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "eval": "tsx scripts/run-eval.ts",
    "eval:smoke": "tsx scripts/run-eval.ts --smoke",
    "gen:wav": "tsx scripts/gen-synthetic-wav.ts",
    "pairwise": "python scripts/pairwise.py eval/factors.pict",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --import tsx tests/unit/*.test.ts",
    "check-secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
