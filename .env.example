# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.

# AmiVoice API appkey. 無償クーポン(月10時間, 5・6月): Na5bkyRHoi
# 取得: https://acp.amivoice.com/blog/zenn_2026/
AMIVOICE_APPKEY=

# AmiVoice endpoints (defaults shown; override only if docs change)
AMIVOICE_HTTP_SYNC_URL=https://acp-api.amivoice.com/v1/recognize
AMIVOICE_HTTP_ASYNC_URL=https://acp-api-async.amivoice.com/v1/recognitions
AMIVOICE_WS_URL=wss://acp-api.amivoice.com/v1/

# ASR engine grammar. 汎用: -a-general / 汎用(数字優先): -a-general-input 等
AMIVOICE_GRAMMAR=-a-general

# Anthropic API key for LLM extraction + LLM-as-judge
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Offline mode: when true (or when AMIVOICE_APPKEY is empty), the web app and
# eval harness use the local mock ASR instead of calling the real API.
# This keeps CI green and the article reproducible without burning the coupon.
USE_MOCK_ASR=true

# Local mock ASR websocket port
MOCK_ASR_PORT=9100

# Web app port
APP_PORT=8080
